#!/usr/bin/env ruby

# In a checkout, load the repo's Gemfile so this runs without `bundle exec`.
# An installed gem has no Gemfile beside it and skips this.
gemfile = File.expand_path("../Gemfile", __dir__)
if File.exist?(gemfile)
  ENV["BUNDLE_GEMFILE"] ||= gemfile
  require "bundler/setup"
end

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "bootleg"

exit Bootleg::CLI.start(ARGV)
